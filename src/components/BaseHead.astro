---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import defaultOg from '../assets/blog-placeholder-1.jpg';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

interface AlternateLink {
	hreflang: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: unknown;
	noindex?: boolean;
	lang?: string;
	ogLocale?: string;
	alternates?: AlternateLink[];
	xDefault?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image,
	type = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
	noindex = false,
	lang = 'tr',
	ogLocale = 'tr_TR',
	alternates = [],
	xDefault,
} = Astro.props;

const ogImage = await getImage({ src: image ?? defaultOg, width: 1200, height: 600, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, Astro.site);
const ogImageAlt = image ? title : SITE_TITLE;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/ai-catalog+json" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="max-image-preview:large" />}

<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="600" />
<meta property="og:image:alt" content={ogImageAlt} />

{type === 'article' && publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && (
	<meta property="article:author" content={SITE_AUTHOR} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{jsonLd && (
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
)}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9919961021600092"
	crossorigin="anonymous"></script>

<script is:inline>
	(() => {
		const modelContext = document.modelContext;
		if (!modelContext || typeof modelContext.registerTool !== 'function') return;

		let postsPromise;
		const loadPosts = () => {
			if (!postsPromise) {
				postsPromise = fetch('/llms.txt')
					.then((response) => {
						if (!response.ok) throw new Error('llms.txt alınamadı');
						return response.text();
					})
					.then((text) => {
						const posts = text.split(/^## Yazılar$/m)[1]?.split(/^## /m)[0] || '';
						return posts
							.split('\n')
							.map((line) => line.match(/^- \[([^\]]+)\]\((https?:\/\/[^)]+)\) — (.*)$/))
							.filter(Boolean)
							.map((match) => ({
								title: match[1],
								url: match[2],
								description: match[3],
							}));
					});
			}
			return postsPromise;
		};

		const format = (posts) =>
			posts
				.map((post, index) => `${index + 1}. ${post.title}\n   ${post.url}\n   ${post.description}`)
				.join('\n\n');

		const clamp = (value, min, max, fallback) =>
			Math.max(min, Math.min(max, Number.isFinite(Number(value)) ? Number(value) : fallback));

		Promise.resolve()
			.then(() =>
				modelContext.registerTool({
					name: 'search_fosstr',
					description:
						'fosstr.com üzerindeki Türkçe yazılarda başlık ve açıklama üzerinden arama yapar; başlık, URL ve kısa açıklama döndürür.',
					inputSchema: {
						type: 'object',
						properties: {
							query: {
								type: 'string',
								minLength: 1,
								description: 'Aranacak kelime veya kelimeler; örn. "linux kernel" veya "CVE".',
							},
							limit: {
								type: 'integer',
								minimum: 1,
								maximum: 10,
								default: 5,
								description: 'Döndürülecek en fazla sonuç sayısı.',
							},
						},
						required: ['query'],
						additionalProperties: false,
					},
					annotations: {
						readOnlyHint: true,
						untrustedContentHint: false,
						consequentialHint: false,
					},
					execute: async ({ query, limit = 5 }) => {
						const posts = await loadPosts();
						const terms = query.toLocaleLowerCase('tr').split(/\s+/).filter(Boolean);
						const hits = posts
							.filter((post) => {
								const haystack = `${post.title} ${post.description} ${post.url}`.toLocaleLowerCase('tr');
								return terms.every((term) => haystack.includes(term));
							})
							.slice(0, clamp(limit, 1, 10, 5));
						return hits.length ? format(hits) : `"${query}" için sonuç bulunamadı.`;
					},
				}),
			)
			.then(() =>
				modelContext.registerTool({
					name: 'latest_fosstr_posts',
					description: 'fosstr.com üzerindeki en yeni Türkçe yazıları listeler.',
					inputSchema: {
						type: 'object',
						properties: {
							limit: {
								type: 'integer',
								minimum: 1,
								maximum: 20,
								default: 5,
								description: 'Döndürülecek yazı sayısı.',
							},
						},
						additionalProperties: false,
					},
					annotations: {
						readOnlyHint: true,
						untrustedContentHint: false,
						consequentialHint: false,
					},
					execute: async ({ limit = 5 }) => {
						const posts = await loadPosts();
						return format(posts.slice(0, clamp(limit, 1, 20, 5)));
					},
				}),
			)
			.catch((error) => console.warn('WebMCP araçları kaydedilemedi:', error));
	})();
</script>

