---
interface Props {
	label: string;
	id?: string;
	contentClass?: string;
}

const { label, id, contentClass = 'lg:py-6 pb-6 pt-2' } = Astro.props;
---

<section {id} class="border-t border-line lg:grid lg:grid-cols-12" style={id ? 'scroll-margin-top: 5rem;' : undefined}>
	<div class="px-6 pt-10 md:px-10 lg:col-span-3 lg:border-r lg:border-line lg:py-10">
		<div class="lg:sticky lg:top-[calc(var(--nav-h)+2rem)]">
			<h2 class="t-section">{label}</h2>
		</div>
	</div>
	<div class:list={['px-6 md:px-10 lg:col-span-9', contentClass]}>
		<slot />
	</div>
</section>
