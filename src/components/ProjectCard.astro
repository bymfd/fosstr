---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href: string;
	title: string;
	description: string;
	heroImage?: ImageMetadata;
	repo?: string;
}

const { href, title, description, heroImage, repo } = Astro.props;
const repoLabel = repo ? repo.replace(/^https?:\/\/(www\.)?/, '') : undefined;
---

<li class="group min-w-0">
	<a href={href} class="block">
		<div class="relative aspect-[16/9] overflow-hidden rounded-[10px] border border-line bg-card transition-colors duration-200 group-hover:border-accent">
			{heroImage ? (
				<Image
					width={1200}
					height={675}
					src={heroImage}
					alt={`${title} önizlemesi`}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025]"
				/>
			) : (
				<div class="flex h-full w-full items-center justify-center font-mono text-sm text-faint">{title}</div>
			)}
		</div>
		<div class="mt-3 flex items-baseline gap-x-3">
			<h3 class="t-item min-w-0 truncate transition-colors duration-150 group-hover:text-accent">
				{title}
			</h3>
		</div>
		<p class="t-sm mt-1 line-clamp-2 min-h-10 text-muted">{description}</p>
		{repoLabel && (
			<p class="mt-1.5 flex min-w-0 gap-3 font-mono text-[0.75rem] leading-4 text-faint">
				<span class="truncate">{repoLabel}</span>
			</p>
		)}
	</a>
</li>
