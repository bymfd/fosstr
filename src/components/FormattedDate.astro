---
interface Props {
	date: Date;
	class?: string;
}

const { date, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<time datetime={date.toISOString()} class:list={[className, 'tabular-nums']}>
	{`${date.getFullYear()}.${pad(date.getMonth() + 1)}.${pad(date.getDate())}`}
</time>
