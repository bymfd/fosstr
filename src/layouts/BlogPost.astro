---
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_URL, SITE_TITLE } from '../consts';
import { slugify } from '../utils';

type Props = CollectionEntry<'blog'>['data'] & { tags?: string[] };

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isPost = Astro.url.pathname.startsWith('/blog/');

const heroImageURL = heroImage
	? new URL((await getImage({ src: heroImage, width: 1200, height: 600, format: 'jpg' })).src, Astro.site).href
	: undefined;

const breadcrumb = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: SITE_URL },
		...(isPost
			? [{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog/` }]
			: []),
		{
			'@type': 'ListItem',
			position: isPost ? 3 : 2,
			name: title,
			item: canonicalURL.href,
		},
	],
};

const pageJsonLd = isPost
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				inLanguage: 'tr',
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
				author: { '@type': 'Person', name: SITE_AUTHOR, url: 'https://github.com/bymfd' },
				publisher: { '@type': 'Person', name: SITE_TITLE, url: SITE_URL },
				...(heroImageURL && { image: [heroImageURL] }),
				...(tags.length > 0 && { keywords: tags.join(', ') }),
			},
			breadcrumb,
		]
	: {
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			name: title,
			description,
			inLanguage: 'tr',
			url: canonicalURL.href,
		};
---

<html lang="tr">
	<head>
		<BaseHead
			title={`${title} | fosstr`}
			description={description}
			image={heroImage}
			type={isPost ? 'article' : 'website'}
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			jsonLd={pageJsonLd}
		/>
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 max-w-3xl mx-auto px-4 py-12 w-full">
			<article>
				{heroImage && (
					<div class="mb-8 rounded-xl overflow-hidden">
						<Image width={1020} height={510} src={heroImage} alt="" class="w-full h-auto" />
					</div>
				)}
				<header class="mb-8">
					<FormattedDate date={pubDate} class="text-sm text-slate-500 dark:text-slate-400 mb-2 block" />
					{updatedDate && (
						<p class="text-xs text-slate-400 dark:text-slate-500 italic">
							Son güncelleme: <FormattedDate date={updatedDate} />
						</p>
					)}
					<h1 class="text-4xl font-bold text-slate-900 dark:text-white mt-3 mb-4 tracking-tight">
						{title}
					</h1>
					{isPost && tags.length > 0 && (
						<ul class="flex flex-wrap gap-2 mb-4">
							{tags.map((tag) => (
								<li>
									<a
										href={`/blog/tags/${slugify(tag)}/`}
										class="inline-block rounded-full border border-slate-200 dark:border-slate-700 px-3 py-1 text-xs text-slate-600 dark:text-slate-400 hover:border-accent hover:text-accent transition-colors"
									>
										#{tag}
									</a>
								</li>
							))}
						</ul>
					)}
					<div class="border-b border-slate-200 dark:border-slate-700"></div>
				</header>
				<div class="prose max-w-none">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
