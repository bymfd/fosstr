---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostRow from '../../components/PostRow.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', (post) => post.data.type === 'post')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = `Yazılar | ${SITE_TITLE}`;
const description =
	'Yazılım, siber güvenlik, yapay zeka ve sistem programlama üzerine yazılar: analizler, rehberler ve notlar.';
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: title,
	description,
	inLanguage: 'tr',
	url: new URL('/blog/', Astro.site).href,
};
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={title} description={description} jsonLd={jsonLd} />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 px-5 md:px-10">
			<div class="mx-auto max-w-[var(--frame)] border-x border-line">
				<section class="px-6 py-16 md:px-10 md:py-20">
					<h1 class="t-display">Yazılar</h1>
					<p class="t-lead mt-5 max-w-[58ch] text-muted">{description}</p>
				</section>
				<div class="border-t border-line px-6 py-6 md:px-10">
					{posts.length === 0 ? (
						<p class="py-8 text-muted">Henüz yazı yok. Yakında!</p>
					) : (
						<ul class="divide-y divide-line">
							{posts.map((post) => (
								<PostRow
									href={`/blog/${post.id}/`}
									title={post.data.title}
									description={post.data.description}
									date={post.data.pubDate}
								/>
							))}
						</ul>
					)}
					<div class="mt-6 border-t border-line pt-4">
						<a href="/projects/" class="link-accent">
							Projeleri gör
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
