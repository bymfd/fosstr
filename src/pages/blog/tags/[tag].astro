---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostRow from '../../../components/PostRow.astro';
import { SITE_TITLE } from '../../../consts';
import { slugify } from '../../../utils';

export async function getStaticPaths() {
	const entries = await getCollection('blog');
	const byTag = new Map<string, string[]>();

	for (const post of entries) {
		for (const tag of post.data.tags ?? []) {
			const existing = byTag.get(tag) ?? [];
			existing.push(post.id);
			byTag.set(tag, existing);
		}
	}

	return [...byTag.entries()].map(([tag, ids]) => ({
		params: { tag: slugify(tag) },
		props: { tag, ids },
	}));
}

type Props = { tag: string; ids: string[] };

const { tag, ids } = Astro.props;
const entries = (await getCollection('blog'))
	.filter((post) => ids.includes(post.id))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `#${tag} | ${SITE_TITLE}`;
const description = `#${tag} etiketiyle işaretlenmiş ${entries.length} içerik: yazılar ve projeler.`;
const pageURL = new URL(`/blog/tags/${slugify(tag)}/`, Astro.site).href;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: title,
		description,
		inLanguage: 'tr',
		url: pageURL,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: Astro.site?.href },
			{ '@type': 'ListItem', position: 2, name: 'Yazılar', item: `${Astro.site}blog/` },
			{ '@type': 'ListItem', position: 3, name: `#${tag}`, item: pageURL },
		],
	},
];
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={title} description={description} jsonLd={jsonLd} />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 px-5 md:px-10">
			<div class="mx-auto max-w-[var(--frame)] border-x border-line">
				<section class="px-6 py-16 md:px-10 md:py-20">
					<h1 class="t-display">#{tag}</h1>
					<p class="t-lead mt-5 text-muted">
						{entries.length} içerik — yazılar ve projeler.
					</p>
				</section>
				<div class="border-t border-line px-6 py-6 md:px-10">
					<ul class="divide-y divide-line">
						{entries.map((entry) => (
							<PostRow
								href={`/${entry.data.type === 'project' ? 'projects' : 'blog'}/${entry.id}/`}
								title={entry.data.title}
								description={entry.data.description}
								date={entry.data.pubDate}
								badge={entry.data.type === 'project' ? 'PROJE' : 'YAZI'}
							/>
						))}
					</ul>
					<div class="mt-6 border-t border-line pt-4">
						<a href="/blog/" class="link-accent">
							Tüm yazılar
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
