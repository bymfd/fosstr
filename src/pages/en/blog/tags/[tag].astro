---
import { getCollection } from 'astro:content';
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import Header from '../../../../components/Header.astro';
import PostRow from '../../../../components/PostRow.astro';
import { SITE_TITLE } from '../../../../consts';
import { slugify } from '../../../../utils';

export async function getStaticPaths() {
	const [posts, projects] = await Promise.all([getCollection('blogEn'), getCollection('projectsEn')]);
	const byTag = new Map<string, { tag: string; ids: string[] }>();

	for (const entry of [...posts, ...projects]) {
		for (const tag of entry.data.tags ?? []) {
			const slug = slugify(tag);
			const existing = byTag.get(slug) ?? { tag, ids: [] };
			if (!existing.ids.includes(entry.id)) existing.ids.push(entry.id);
			byTag.set(slug, existing);
		}
	}

	return [...byTag.entries()].map(([slug, value]) => ({
		params: { tag: slug },
		props: value,
	}));
}

type Props = { tag: string; ids: string[] };

const { tag, ids } = Astro.props;
const entries = [...(await getCollection('blogEn')), ...(await getCollection('projectsEn'))]
	.filter((entry) => ids.includes(entry.id))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `#${tag} | ${SITE_TITLE}`;
const description = `${entries.length} item tagged #${tag}: posts and projects.`;
const pageURL = new URL(`/en/blog/tags/${slugify(tag)}/`, Astro.site).href;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: title,
		description,
		inLanguage: 'en',
		url: pageURL,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/en/', Astro.site).href },
			{ '@type': 'ListItem', position: 2, name: 'Posts', item: new URL('/en/blog/', Astro.site).href },
			{ '@type': 'ListItem', position: 3, name: `#${tag}`, item: pageURL },
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} jsonLd={jsonLd} noindex={true} lang="en" ogLocale="en_US" />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header alternates={{ tr: '/blog/', en: '/en/blog/' }} />
		<main class="flex-1 px-5 md:px-10">
			<div class="mx-auto max-w-[var(--frame)] border-x border-line">
				<section class="px-6 py-16 md:px-10 md:py-20">
					<h1 class="t-display">#{tag}</h1>
					<p class="t-lead mt-5 text-muted">
						{entries.length} items — posts and projects.
					</p>
				</section>
				<div class="border-t border-line px-6 py-6 md:px-10">
					<ul class="divide-y divide-line">
						{entries.map((entry) => (
							<PostRow
								href={entry.data.type === 'project' ? `/en/projects/${entry.id}/` : `/en/blog/${entry.id}/`}
								title={entry.data.title}
								description={entry.data.description}
								date={entry.data.pubDate}
								badge={entry.data.type === 'project' ? 'PROJECT' : 'POST'}
							/>
						))}
					</ul>
					<div class="mt-6 border-t border-line pt-4">
						<a href="/en/blog/" class="link-accent">
							All posts
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
