---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostRow from '../../components/PostRow.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Section from '../../components/Section.astro';
import { SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../../consts';
import { buildAlternates } from '../../i18n';

const description = 'Turkish and English notes on cybersecurity, CVE analysis, open-source tools and systems programming.';
const posts = (await getCollection('blog', (post) => post.data.type === 'post'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const postCount = (await getCollection('blog', (post) => post.data.type === 'post')).length;
const projects = (await getCollection('projectsEn', (post) => post.data.type === 'project'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
const projectCount = (await getCollection('projectsEn', (post) => post.data.type === 'project')).length;
const { alternates, xDefault } = buildAlternates('/en/', Astro.site);

const jsonLd = [
	{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_TITLE, url: `${SITE_URL}/en/`, description, inLanguage: 'en' },
	{ '@context': 'https://schema.org', '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL, sameAs: ['https://github.com/bymfd'] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Cybersecurity, software and open source notes`} description={description} jsonLd={jsonLd} lang="en" ogLocale="en_US" alternates={alternates} xDefault={xDefault} />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1 px-5 md:px-10">
			<div class="mx-auto max-w-[var(--frame)] border-x border-line">
				<section class="px-6 py-16 md:px-10 md:py-20">
					<h1 class="t-display rise" style="animation-delay: 40ms">fosstr</h1>
					<p class="t-lead mt-5 max-w-[58ch] text-muted rise" style="animation-delay: 100ms">{description}</p>
					<div class="mt-8 flex flex-wrap gap-3 rise" style="animation-delay: 160ms">
						<a href="/en/blog/" class="btn-solid">Read posts</a>
						<a href="/en/projects/" class="btn-outline">View projects</a>
					</div>
				</section>

				<div class="border-t border-line px-6 py-4 md:px-10">
					<div class="flex items-center gap-6">
						<span class="hidden h-px flex-1 bg-line sm:block"></span>
						<p class="text-center font-mono text-[0.8125rem] leading-5 tracking-[0.025em] text-muted">Security, software and tools I build</p>
						<span class="hidden h-px flex-1 bg-line sm:block"></span>
					</div>
				</div>

				<Section label="Posts" id="posts">
					<ul class="divide-y divide-line">
						{posts.map((post) => (
							<PostRow href={`/blog/${post.id}/`} title={post.data.title} description={post.data.description} date={post.data.pubDate} />
						))}
					</ul>
					<a href="/en/blog/" class="link-accent mt-4 inline-flex">All posts ({postCount}) <span aria-hidden="true">→</span></a>
					<p class="t-sm mt-2 text-faint">Posts are currently in Turkish; English posts will be added over time.</p>
				</Section>

				<Section label="Projects" id="projects" contentClass="lg:py-10 pb-10 pt-6">
					<ul class="grid grid-cols-1 gap-x-6 gap-y-9 sm:grid-cols-2">
						{projects.map((project) => (
							<ProjectCard href={`/en/projects/${project.id}/`} title={project.data.title} description={project.data.description} heroImage={project.data.heroImage} repo={project.data.repo} />
						))}
					</ul>
					<a href="/en/projects/" class="link-accent mt-9 inline-flex">All projects ({projectCount}) <span aria-hidden="true">→</span></a>
				</Section>

				<Section label="Contact" id="contact" contentClass="lg:py-10 pb-10 pt-4">
					<p class="t-sub"><a href="mailto:hello@fosstr.com" class="underline decoration-accent decoration-1 underline-offset-[0.25em] transition-colors duration-150 hover:text-accent">hello@fosstr.com</a></p>
					<p class="t-lead mt-4 max-w-[56ch] text-muted">Open to collaborations and long-form discussions on software, security and infrastructure.</p>
					<div class="t-sm mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
						<a href="https://github.com/bymfd" target="_blank" rel="noopener noreferrer" class="link-arrow text-muted transition-colors duration-150 hover:text-ink">GitHub</a>
						<a href="/rss.xml" class="link-arrow text-muted transition-colors duration-150 hover:text-ink">RSS</a>
					</div>
				</Section>
			</div>
		</main>
		<Footer />
	</body>
</html>