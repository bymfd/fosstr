---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { SITE_URL } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('blog', (post) => post.data.type === 'project');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'blog'>;

const project = Astro.props;
const { Content } = await render(project);
const translated = new Set(['arch-kam', 'fcm', 'tree-py', 'velesbit']);
const trHref = `${SITE_URL}/projects/${project.id}/`;
const enHref = `${SITE_URL}/en/projects/${project.id}/`;
const alternates = translated.has(project.id)
	? [{ hreflang: 'tr', href: trHref }, { hreflang: 'en', href: enHref }]
	: [{ hreflang: 'tr', href: trHref }];
const xDefault = trHref;
---

<BlogPost {...project.data} alternates={alternates} xDefault={xDefault}>
	<Content />
</BlogPost>
